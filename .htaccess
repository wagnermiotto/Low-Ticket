# ═══════════ KNOWLY RESUMOS ═══════════

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /livro/adam-smith  ->  livro.html?slug=adam-smith
  RewriteRule ^livro/([A-Za-z0-9-]+)/?$ livro.html?slug=$1 [L,QSA]
</IfModule>

# Cache longo para as capas (o nome do arquivo muda quando a capa muda)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# O catálogo muda com frequência: revalida sempre
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Comprime texto (o catálogo em JSON encolhe bastante). WebP já vem comprimido.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
